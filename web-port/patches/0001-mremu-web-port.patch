@@ -65,7 +65,12 @@ namespace Memory {
 	{
 		shared_memory_size = shared_memory_size_l;
 
+		#ifdef __EMSCRIPTEN__ // MREMU_WEB_PATCH
+		// wasm 线性内存里 16MB 对齐只会白吃堆，4KB 页对齐就满足 uc_mem_map_ptr
